# Modelo: scripts/dev-up.sh gera um .env local com credenciais aleatorias.
# Para uso manual, substitua todos os valores SUBSTITUIR antes de iniciar os servicos.
POSTGRES_USER=SUBSTITUIR
POSTGRES_PASSWORD=SUBSTITUIR
POSTGRES_DB=financas_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_UI_HOST=127.0.0.1
MAILPIT_BIND_ADDRESS=127.0.0.1
IdentitySeed__Enabled=false
IdentitySeed__AdministratorEmail=admin@financas.local
IdentitySeed__AdministratorPassword=SUBSTITUIR
ASPNETCORE_ENVIRONMENT=Development
