@using FinancasSaaS.Web.Components.Shared
@using FinancasSaaS.Web.Components.Ui

<OperationFeedback State="@MutationState" Message="@MutationMessage" />
<OperationFeedback State="@(IsRefreshing ? OperationFeedbackState.Loading : RefreshState)" Message="@RefreshMessage" />

@code {
    [Parameter]
    public OperationFeedbackState MutationState { get; set; }

    [Parameter]
    public string? MutationMessage { get; set; }

    [Parameter]
    public bool IsRefreshing { get; set; }

    [Parameter]
    public OperationFeedbackState RefreshState { get; set; }

    [Parameter]
    public string? RefreshMessage { get; set; }
}
