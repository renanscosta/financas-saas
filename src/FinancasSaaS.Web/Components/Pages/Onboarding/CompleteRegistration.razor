@page "/concluir-cadastro"
@layout OnboardingLayout
@using System.ComponentModel.DataAnnotations
@using FinancasSaaS.Application.Platform.CompleteRegistration
@using FinancasSaaS.Web.Components.Ui
@inject CompleteRegistrationUseCase CompleteRegistrationService
@inject NavigationManager Navigation

<PageTitle>Concluir cadastro</PageTitle>

<MudPaper Class="onboarding-card" Elevation="0" Outlined="true">
    <p class="eyebrow">PRIMEIRO ACESSO</p>
    <MudText Typo="Typo.h4" HtmlTag="h1">Concluir cadastro</MudText>
    <MudText Typo="Typo.body1" Class="onboarding-intro">Defina sua senha para concluir o acesso à sua conta.</MudText>

    <EditForm Model="Form" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <label for="password">Senha</label>
        <MudTextField id="password" @bind-Value="Form.Password" For="@(() => Form.Password)"
                      InputType="InputType.Password" autocomplete="new-password" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Required="true" />
        <label for="confirmation">Confirmação da senha</label>
        <MudTextField id="confirmation" @bind-Value="Form.Confirmation" For="@(() => Form.Confirmation)"
                      InputType="InputType.Password" autocomplete="new-password" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Required="true" />
        <MudButton Class="onboarding-submit" ButtonType="ButtonType.Submit" Color="Color.Primary"
                   Variant="Variant.Filled" Disabled="@IsSubmitting" FullWidth="true">
            @(IsSubmitting ? "Concluindo..." : "Concluir cadastro")
        </MudButton>
    </EditForm>

    <OperationFeedback State="@(IsSubmitting ? OperationFeedbackState.Loading : FeedbackState)"
                       Message="@(IsSubmitting ? "Concluindo o cadastro com segurança." : Message)" />
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private readonly FormModel Form = new();
    private bool IsSubmitting;
    private string? Message;
    private OperationFeedbackState FeedbackState;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(Token) || Form.Password != Form.Confirmation)
        {
            Message = "O link é inválido ou as senhas não conferem.";
            FeedbackState = OperationFeedbackState.Validation;
            return;
        }

        IsSubmitting = true;
        FeedbackState = OperationFeedbackState.Idle;
        Message = null;
        try
        {
            var result = await CompleteRegistrationService.ExecuteAsync(
                new CompleteRegistrationCommand(Token, Form.Password));
            Message = result is null
                ? "Não foi possível concluir o cadastro. O link pode estar expirado ou a conta indisponível."
                : "Cadastro concluído. O acesso será disponibilizado conforme as políticas da conta.";
            FeedbackState = result is null ? OperationFeedbackState.Error : OperationFeedbackState.Success;
        }
        catch (Exception)
        {
            Message = "Não foi possível concluir o cadastro.";
            FeedbackState = OperationFeedbackState.Error;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Informe uma senha.")]
        [MinLength(12, ErrorMessage = "A senha deve ter pelo menos 12 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirme a senha.")]
        public string Confirmation { get; set; } = string.Empty;
    }
}
