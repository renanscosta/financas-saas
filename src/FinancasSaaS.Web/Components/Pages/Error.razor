@page "/Error"
@using System.Diagnostics

<PageTitle>Erro | Finanças SaaS</PageTitle>

<section class="error-page">
    <h1 class="error-heading">Não foi possível concluir esta solicitação.</h1>
    <p class="error-message">Ocorreu um erro inesperado. Tente novamente mais tarde.</p>

    @if (ShowRequestId)
    {
        <p>
            <strong>Identificador da solicitação:</strong> <code>@RequestId</code>
        </p>
    }

    <h3>Ambiente de desenvolvimento</h3>
    <p>
        O ambiente <strong>Development</strong> pode exibir informações mais detalhadas sobre o erro ocorrido.
    </p>
    <p>
        <strong>O ambiente Development não deve ser usado em aplicações publicadas.</strong>
        Isso pode expor informações sensíveis de exceções. Para depuração local, configure
        <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong> e reinicie a aplicação.
    </p>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
