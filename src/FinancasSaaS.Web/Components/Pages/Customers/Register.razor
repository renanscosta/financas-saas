@page "/platform/customers/register"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using FinancasSaaS.Application.Platform.RegisterCustomer
@using FinancasSaaS.Web.Components.Ui
@using FinancasSaaS.Web.Security
@attribute [Authorize(Policy = PlatformPolicies.MutateProvisioning)]
@inject RegisterCustomerUseCase RegisterCustomer
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Cadastrar cliente</PageTitle>

<h1>Cadastrar cliente</h1>
<p>Cadastre uma pessoa cliente para iniciar o provisionamento do tenant.</p>

<EditForm Model="Form" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <MudTextField id="email" @bind-Value="Form.Email" For="@(() => Form.Email)" Label="E-mail"
                  InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@IsSubmitting">
        @(IsSubmitting ? "Salvando..." : "Cadastrar")
    </MudButton>
</EditForm>

<OperationFeedback State="@(IsSubmitting ? OperationFeedbackState.Loading : FeedbackState)"
                   Message="@(IsSubmitting ? "Cadastrando o cliente e iniciando o provisionamento." : Message)" />

@code {
    private readonly FormModel Form = new();
    private bool IsSubmitting;
    private string? Message;
    private OperationFeedbackState FeedbackState;

    private async Task SubmitAsync()
    {
        IsSubmitting = true;
        FeedbackState = OperationFeedbackState.Idle;
        Message = null;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var actorId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? authenticationState.User.Identity?.Name;
            if (string.IsNullOrWhiteSpace(actorId))
            {
                Message = "Não foi possível identificar o operador autenticado.";
                FeedbackState = OperationFeedbackState.Error;
                return;
            }

            var result = await RegisterCustomer.ExecuteAsync(new RegisterCustomerCommand(Form.Email, actorId));
            Message = result.AlreadyExists
                ? "O cliente já estava cadastrado; nenhum dado foi duplicado."
                : $"Cliente cadastrado. Tenant: {result.TenantId}";
            FeedbackState = OperationFeedbackState.Success;
        }
        catch (ArgumentException exception)
        {
            Message = exception.Message;
            FeedbackState = OperationFeedbackState.Validation;
        }
        catch (Exception)
        {
            Message = "Não foi possível concluir o cadastro. Consulte os registros administrativos.";
            FeedbackState = OperationFeedbackState.Error;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Informe o e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Email { get; set; } = string.Empty;
    }
}
