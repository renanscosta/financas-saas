@page "/platform/customers/deactivate"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using FinancasSaaS.Application.Platform.DeactivateCustomer
@using FinancasSaaS.Web.Components.Ui
@using FinancasSaaS.Web.Security
@attribute [Authorize(Policy = PlatformPolicies.MutateProvisioning)]
@inject DeactivateCustomerUseCase DeactivateCustomer
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Desativar cliente</PageTitle>

<h1>Desativar cliente</h1>
<p>A desativação preserva os dados, bloqueia o acesso e invalida convites ativos.</p>

<EditForm Model="Form" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <MudTextField id="customerId" @bind-Value="Form.CustomerId" For="@(() => Form.CustomerId)" Label="Cliente"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
    <MudTextField id="reason" @bind-Value="Form.Reason" For="@(() => Form.Reason)" Label="Motivo" Lines="3"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
    <MudButton ButtonType="ButtonType.Submit" Color="Color.Error" Variant="Variant.Filled" Disabled="@IsSubmitting">
        @(IsSubmitting ? "Desativando..." : "Desativar cliente")
    </MudButton>
</EditForm>

<OperationFeedback State="@(IsSubmitting ? OperationFeedbackState.Loading : FeedbackState)"
                   Message="@(IsSubmitting ? "Desativando o cliente e bloqueando os convites ativos." : Message)" />

@code {
    private readonly FormModel Form = new();
    private bool IsSubmitting;
    private string? Message;
    private OperationFeedbackState FeedbackState;

    private async Task SubmitAsync()
    {
        Message = null;
        if (!Guid.TryParse(Form.CustomerId, out var customerId))
        {
            Message = "Informe um identificador de cliente válido.";
            FeedbackState = OperationFeedbackState.Validation;
            return;
        }

        IsSubmitting = true;
        FeedbackState = OperationFeedbackState.Idle;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var actorId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? authenticationState.User.Identity?.Name;
            if (string.IsNullOrWhiteSpace(actorId))
            {
                Message = "Não foi possível identificar o operador autenticado.";
                FeedbackState = OperationFeedbackState.Error;
                return;
            }

            var result = await DeactivateCustomer.ExecuteAsync(
                new DeactivateCustomerCommand(customerId, actorId, Form.Reason));
            Message = result is null
                ? "Cliente não encontrado ou já desativado."
                : "Cliente desativado. O acesso foi bloqueado e os convites ativos foram invalidados.";
            FeedbackState = result is null ? OperationFeedbackState.Validation : OperationFeedbackState.Success;
        }
        catch (ArgumentException exception)
        {
            Message = exception.Message;
            FeedbackState = OperationFeedbackState.Validation;
        }
        catch (Exception)
        {
            Message = "Não foi possível desativar o cliente. Consulte os registros administrativos.";
            FeedbackState = OperationFeedbackState.Error;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Informe o identificador do cliente.")]
        public string CustomerId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o motivo da desativação.")]
        public string Reason { get; set; } = string.Empty;
    }
}