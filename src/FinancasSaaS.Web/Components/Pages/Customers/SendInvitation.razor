@page "/platform/customers/invite"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using FinancasSaaS.Application.Platform.Invitations
@using FinancasSaaS.Web.Components.Ui
@using FinancasSaaS.Web.Security
@attribute [Authorize(Policy = PlatformPolicies.MutateProvisioning)]
@inject SendInvitationUseCase SendInvitationService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Enviar convite</PageTitle>

<h1>Enviar convite</h1>
<p>Envie um link de conclusão de cadastro sem incluir senha na mensagem.</p>

<EditForm Model="Form" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <MudTextField id="customerId" @bind-Value="Form.CustomerId" For="@(() => Form.CustomerId)" Label="Cliente"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
    <MudTextField id="tenantId" @bind-Value="Form.TenantId" For="@(() => Form.TenantId)" Label="Tenant"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
    <MudTextField id="userId" @bind-Value="Form.UserId" For="@(() => Form.UserId)" Label="Usuário"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
    <MudTextField id="recipient" @bind-Value="Form.Recipient" For="@(() => Form.Recipient)" Label="E-mail"
                  InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@IsSubmitting">
        @(IsSubmitting ? "Enviando..." : "Enviar convite")
    </MudButton>
</EditForm>

<OperationFeedback State="@(IsSubmitting ? OperationFeedbackState.Loading : FeedbackState)"
                   Message="@(IsSubmitting ? "Enviando o convite para a pessoa destinatária." : Message)" />

@code {
    private readonly FormModel Form = new();
    private bool IsSubmitting;
    private string? Message;
    private OperationFeedbackState FeedbackState;

    private async Task SubmitAsync()
    {
        Message = null;
        if (!Guid.TryParse(Form.CustomerId, out var customerId) ||
            !Guid.TryParse(Form.TenantId, out var tenantId) ||
            !Guid.TryParse(Form.UserId, out var userId))
        {
            Message = "Informe identificadores válidos para cliente, tenant e usuário.";
            FeedbackState = OperationFeedbackState.Validation;
            return;
        }

        IsSubmitting = true;
        FeedbackState = OperationFeedbackState.Idle;
        try
        {
            await SendInvitationService.ExecuteAsync(new SendInvitationCommand(
                customerId,
                tenantId,
                userId,
                Form.Recipient,
                Navigation.BaseUri.TrimEnd('/'),
                await GetActorIdAsync()));
            Message = "Convite enviado. A mensagem contém somente o link de conclusão.";
            FeedbackState = OperationFeedbackState.Success;
        }
        catch (ArgumentException exception)
        {
            Message = exception.Message;
            FeedbackState = OperationFeedbackState.Validation;
        }
        catch (Exception)
        {
            Message = "Não foi possível enviar o convite. Confirme se o cliente está elegível e tente novamente.";
            FeedbackState = OperationFeedbackState.Error;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task<string> GetActorIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? state.User.Identity?.Name
            ?? "unknown";
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Informe o cliente.")]
        public string CustomerId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o tenant.")]
        public string TenantId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o usuário.")]
        public string UserId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Recipient { get; set; } = string.Empty;
    }
}