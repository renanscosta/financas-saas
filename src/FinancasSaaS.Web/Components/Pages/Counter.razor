@page "/counter"

<PageTitle>Contador de demonstração</PageTitle>

<section class="demo-page">
    <h1>Contador de demonstração</h1>

    <p role="status">Contagem atual: @currentCount</p>

    <button class="demo-button" @onclick="IncrementCount">Adicionar 1</button>
</section>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
