@using FinancasSaaS.Web.Security

<div class="platform-navigation">
    <button class="navigation-toggle" type="button" aria-expanded="@(IsMenuOpen ? "true" : "false")"
            aria-controls="platform-nav" @onclick="ToggleMenu">
        <span aria-hidden="true">☰</span>
        <span>Menu</span>
    </button>

    <nav id="platform-nav" class="platform-nav @(IsMenuOpen ? "is-open" : string.Empty)"
         aria-label="Navegação da plataforma">
        <NavLink class="platform-nav-link" href="/" Match="NavLinkMatch.All" @onclick="CloseMenu">Início</NavLink>
        <AuthorizeView Policy="@PlatformPolicies.MutateProvisioning">
            <Authorized>
                <NavLink class="platform-nav-link" href="platform/customers/register" @onclick="CloseMenu">Cadastrar
                    cliente</NavLink>
                    <NavLink class="platform-nav-link" href="platform/customers/deactivate" @onclick="CloseMenu">Desativar
                        cliente</NavLink>
                        <NavLink class="platform-nav-link" href="platform/customers/invite" @onclick="CloseMenu">Enviar convite
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@PlatformPolicies.ReadProvisioning">
                    <Authorized>
                        <NavLink class="platform-nav-link" href="platform/customers/provisioning" @onclick="CloseMenu">
                            Provisionamento</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView>
                        <Authorized Context="authState">
                            <span class="navigation-user" title="Conta autenticada">@authState.User.Identity?.Name</span>
                            <form class="logout-form" action="/Account/Logout" method="post" data-enhance="false">
                                <AntiforgeryToken />
                                <button class="logout-button" type="submit">Sair da conta</button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <a class="platform-nav-link" href="/Account/Login">Entrar</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </nav>
            </div>

@code {
    private bool IsMenuOpen;

    private void ToggleMenu() => IsMenuOpen = !IsMenuOpen;

    private void CloseMenu() => IsMenuOpen = false;
}

