@inherits LayoutComponentBase

<MudBlazorProviders />

<div class="platform-shell">
    <header class="platform-header">
        <a class="platform-brand" href="/" aria-label="Finanças SaaS — início">
            <span class="brand-mark" aria-hidden="true">F</span>
            <span>Finanças <strong>SaaS</strong></span>
        </a>
        <NavMenu />
    </header>

    <main id="main-content" class="platform-main">
        <div class="platform-page-content">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar a página</a>
    <span class="dismiss" role="button" tabindex="0" aria-label="Dispensar aviso">×</span>
</div>
